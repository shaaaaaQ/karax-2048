{
    "private": true,
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tailwindcss -i ./src/app.css -o ./public/index.css && nimble build -Y",
        "build:release": "tailwindcss -i ./src/app.css -o ./public/index.css --minify && nimble build -Y -d:release",
        "watch": "nodemon --watch src --ext nim,css --exec \"pnpm build\""
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "nodemon": "^3.1.14",
        "tailwindcss": "^4.3.3"
    }
}
